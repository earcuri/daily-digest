# Daily Digest Server Configuration
# Copy this to .env and customize

# REQUIRED: Path to your directory of YYYY-MM-DD.md digest files
DIGEST_DIR=/path/to/your/digests

# Server binding (defaults shown)
DIGEST_PORT=10001
DIGEST_HOST=127.0.0.1

# Your name for the greeting hero section (optional, hidden if empty)
DIGEST_USER_NAME=

# Branding name shown in nav bar and page titles (default: "Daily Digest")
DIGEST_APP_NAME=Daily Digest

# Weather location coordinates (optional, weather disabled if not set)
# Find yours at https://www.latlong.net/
DIGEST_WEATHER_LAT=
DIGEST_WEATHER_LON=

# Extra navigation links as JSON array (optional)
# Each item: {"label": "Display Text", "url": "http://..."}
# Example: [{"label":"Notes","url":"http://localhost:8080"}]
DIGEST_NAV_LINKS=[]
